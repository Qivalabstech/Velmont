    "bcryptjs": "2.4.3",
    "drizzle-orm": "0.45.3",
    "next": "15.5.27",
    "node-html-parser": "7.0.1",
    "nodemailer": "6.10.1",
    "pg": "8.22.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1",
    "sharp": "0.34.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
