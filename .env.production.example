# ===== VELMONT production settings. Copy to .env and fill in. =====

# Your domain, without https:// (point its DNS A record at this server first)
DOMAIN=velmont.in
SITE_URL=https://velmont.in

# Database password: any long random string. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Session signing secret. Generate: openssl rand -hex 32
AUTH_SECRET=change-me

# First owner account, created by the seed command (change the password after first sign-in)
OWNER_EMAIL=you@velmont.in
OWNER_NAME=Your Name
OWNER_PASSWORD=ChangeMe2026

# Razorpay (Dashboard > Accounts & Settings > API Keys). Can also be set in Admin > Settings > Payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_MOCK=false

# Email (Zoho Mail, Google Workspace, Brevo, Amazon SES...)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=orders@velmont.in
SMTP_PASS=
MAIL_FROM=VELMONT <orders@velmont.in>

# Optional
PAGESPEED_API_KEY=
CRON_SECRET=change-me-too
BACKUP_KEEP_DAYS=14
