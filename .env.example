# ---- Required ----
DATABASE_URL="postgresql://velmont:CHANGE_ME@localhost:5432/velmont"
# Public URL of the store, no trailing slash. Used in emails, sitemap, SEO and health checks.
SITE_URL="https://velmont.in"
# Long random string. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Payments (Razorpay) ----
# Keys can also be entered in Admin > Settings > Payments. Values here take priority.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Development only: simulates successful online payments when no Razorpay keys are set. Never enable in production.
PAYMENTS_MOCK="false"

# ---- Email (any SMTP: Zoho, Gmail Workspace, Brevo, Amazon SES) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="VELMONT <orders@velmont.in>"

# ---- First owner account (created by the seed script; required on Vercel and production) ----
OWNER_EMAIL=""
OWNER_NAME=""
OWNER_PASSWORD=""

# ---- Storage ----
# On Vercel: create a Blob store (Storage tab) and connect it; Vercel adds BLOB_READ_WRITE_TOKEN for you.
BLOB_READ_WRITE_TOKEN=""
# Folder for product images uploaded from the admin panel. Mount it as a volume in Docker.
UPLOAD_DIR="./storage/uploads"
BACKUP_DIR="./storage/backups"

# ---- Health page ----
# Optional Google PageSpeed Insights API key (free). Without it, PageSpeed runs are rate-limited.
PAGESPEED_API_KEY=""
# Protects /api/cron. Vercel sends it automatically to the daily job in vercel.json.
CRON_SECRET="change-me-too"
