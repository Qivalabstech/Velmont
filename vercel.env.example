# VELMONT on Vercel: Production environment variables
# Vercel → your project → Settings → Environment Variables → paste this whole file (Vercel imports .env text),
# choose "Production", then fill in every <...> value. Never commit the filled-in copy to GitHub.
# Comments sit on their own lines on purpose: anything after "=" on the same line becomes part of the value.
#
# Added automatically by Vercel integrations, do NOT paste them yourself:
#   DATABASE_URL (and POSTGRES_*)  ← Storage → Neon
#   BLOB_READ_WRITE_TOKEN          ← Storage → Blob

# ---- Site ----
# exact https address, no trailing slash
SITE_URL=https://<your-domain.in>
# openssl rand -base64 48   (signs order links and sessions)
AUTH_SECRET=<random 48+ characters>
# openssl rand -hex 32      (only Vercel Cron may run /api/cron)
CRON_SECRET=<random 32+ characters>
# must stay false in production
PAYMENTS_MOCK=false

# ---- First admin login (used once, at the first deploy) ----
OWNER_EMAIL=<you@your-domain.in>
OWNER_NAME=<Your Name>
# delete this variable after you sign in and change it
OWNER_PASSWORD=<strong password, 12+ characters>

# ---- Cashfree Payments ----
CASHFREE_APP_ID=<App ID from Cashfree → Developers → API Keys>
CASHFREE_SECRET_KEY=<Secret Key from the same screen>
# change to production after Cashfree activates your account
CASHFREE_ENV=sandbox

# ---- Email (order confirmations, password resets) ----
SMTP_HOST=<smtp.zoho.in or your provider>
SMTP_PORT=587
SMTP_USER=<orders@your-domain.in>
SMTP_PASS=<SMTP / app password>
MAIL_FROM="VELMONT <orders@your-domain.in>"

# ---- Optional ----
# Google PageSpeed API key for the Health page (free)
PAGESPEED_API_KEY=
# RAZORPAY_KEY_ID= / RAZORPAY_KEY_SECRET= / RAZORPAY_WEBHOOK_SECRET=   only if you use Razorpay instead
# YOUPI_API_URL= / YOUPI_MERCHANT_ID= / YOUPI_MERCHANT_API_KEY= / YOUPI_WEBHOOK_SECRET=   only for YouPI UPI
